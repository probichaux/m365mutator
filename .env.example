# Required: Microsoft Graph (Entra ID app registration)
GRAPH_CLIENT_ID=
GRAPH_TENANT_ID=

# Graph authentication: use EITHER client secret OR certificate (not both)
GRAPH_CLIENT_SECRET=
# GRAPH_CERTIFICATE_PATH=          # Path to PEM file with cert + private key
# GRAPH_CERTIFICATE_PASSWORD=      # Optional password for encrypted PEM
# GRAPH_SEND_CERTIFICATE_CHAIN=    # Set to 'true' for x5c claim (SNI auth)

# The app registration needs application (not delegated) permissions, admin-consented,
# for whichever mutations this tool will perform, e.g.:
#   User.ReadWrite.All            — update users
#   Mail.ReadWrite, Mail.Send     — create/reply to mail messages
#   Calendars.ReadWrite           — create/update calendar items
#   Files.ReadWrite.All           — OneDrive documents
#   Sites.ReadWrite.All           — SharePoint documents

# Optional: Agent 365 agent identity (Entra Agent ID), used when m365mutator runs
# as an Agent 365 agent. `a365 setup all` writes these values to .env under its
# own names; copy them here. Exchange and SharePoint don't accept agent identity
# tokens yet, so the app registration above still performs workload writes.
# AGENT365_TENANT_ID=              # Defaults to GRAPH_TENANT_ID
# AGENT365_BLUEPRINT_ID=           # Blueprint app ID
# AGENT365_AGENT_ID=               # Agent identity app ID
# AGENT365_AGENT_NAME=
# Blueprint credential: EITHER managed identity (hosted) OR certificate OR client secret (dev only)
# AGENT365_USE_MANAGED_IDENTITY=   # Set to 'true' on App Service with the blueprint federated to its identity
# AGENT365_MANAGED_IDENTITY_CLIENT_ID=  # User-assigned identity only; blank = system-assigned
# AGENT365_CERTIFICATE_PATH=       # PEM with cert + unencrypted private key
# AGENT365_CLIENT_SECRET=

# Optional: run mode. 'agent' runs the scheduler unattended and serves only
# /health and the read-only /api/agent/status (no admin UI). Default: interactive.
# M365MUTATOR_MODE=agent
# Agent mode reads schedule.json and targets.json from M365MUTATOR_DATA_DIR,
# unless these app settings supply them as JSON strings:
# M365MUTATOR_SCHEDULE_JSON=
# M365MUTATOR_TARGETS_JSON=

# Optional
PORT=3700
M365MUTATOR_LOG_PATH=

# The admin UI has no login — anyone who can reach it can read/change this
# config and drive Graph operations. Run it somewhere only trusted operators
# can reach. Config (including Graph secrets, stored as plaintext) is
# persisted under this directory with owner-only file permissions.
M365MUTATOR_DATA_DIR=/data
